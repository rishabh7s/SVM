# Copy this file to .env and fill in real values. Never commit the real .env.

# Required for all LLM-backed extraction and retrieval calls (kivi/llm.py).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Overrides the default model used for structured extraction.
# Defaults to gemini-3.6-flash if unset. Do not use gemini-1.5-flash or
# gemini-2.0-flash -- both are fully shut down (404). gemini-2.5-flash is
# also on a public deprecation timeline; gemini-3.6-flash is the current
# stable production Flash tier as of this writing.
# KIVI_EXTRACTION_MODEL=gemini-3.6-flash

# Optional. Overrides the default model for query condensation -- the cheap,
# single-shot pre-step that rewrites a conversational follow-up into a
# self-contained query. Defaults to gemini-3.5-flash-lite if unset.
# KIVI_LIGHT_MODEL=gemini-3.5-flash-lite

# Optional. Overrides the default model driving the Hey Kivi agent's
# tool-calling loop. Defaults to gemini-3.6-flash if unset. Kept separate
# from KIVI_EXTRACTION_MODEL even where they agree, since ingestion and
# retrieval are separate concerns that may want to diverge.
# KIVI_RETRIEVAL_MODEL=gemini-3.6-flash

# Optional, evaluation only (run_evaluation.py). Your provider's current
# per-1M-token rates. Leave unset and the evaluation reports token counts
# with cost marked "not configured" -- deliberately, so a report never
# carries an invented price.
# KIVI_EVAL_COST_PER_1M_INPUT=
# KIVI_EVAL_COST_PER_1M_OUTPUT=
